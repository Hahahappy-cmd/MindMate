[Unit]
Description=MindMate RQ AI worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mindmate
Group=mindmate
WorkingDirectory=/opt/mindmate/current
EnvironmentFile=/etc/mindmate/worker.env
ExecStart=/opt/mindmate/venv/bin/python -m app.worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/mindmate

[Install]
WantedBy=multi-user.target
