ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://ROLE:PASSWORD@NEON_HOST/DATABASE?sslmode=require
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
REDIS_URL=rediss://default:PASSWORD@UPSTASH_HOST:PORT
AI_QUEUE_NAME=mindmate-ai
JWT_SECRET_KEY=GENERATE_A_UNIQUE_SECRET_OF_AT_LEAST_32_CHARACTERS
REFRESH_JWT_SECRET_KEY=GENERATE_A_DIFFERENT_SECRET_OF_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
PASSWORD_RESET_ENABLED=false
TRUST_PROXY_HEADERS=false
TRUSTED_HOSTS=YOUR_RENDER_SERVICE.onrender.com
ALLOWED_ORIGINS=https://YOUR_RENDER_SERVICE.onrender.com
HF_HOME=/var/cache/mindmate/huggingface
TOKENIZERS_PARALLELISM=false
