ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://your_local_postgres_role@localhost:5432/mindmate
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
JWT_SECRET_KEY=replace-with-a-long-random-access-secret
REFRESH_JWT_SECRET_KEY=replace-with-a-different-long-random-refresh-secret
JWT_ISSUER=mindmate
JWT_AUDIENCE=mindmate-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BYTES=262144
EMOTION_MODEL_NAME=SamLowe/roberta-base-go_emotions
EMOTION_MODEL_REVISION=1895400d2daef02be65e8f3c24559e0aa09d5d25
EMOTION_THRESHOLD=0.5
EMOTION_TOP_N=5
EMOTION_MAX_TOKENS=512
EMOTION_CHUNK_OVERLAP=64
THEME_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
THEME_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
THEME_SIMILARITY_THRESHOLD=0.62
THEME_MAX_TOKENS=256
THEME_CHUNK_OVERLAP=32
REDIS_URL=redis://localhost:6379/0
AI_QUEUE_NAME=mindmate-ai
AI_JOB_TIMEOUT_SECONDS=600
AI_JOB_MAX_RETRIES=3
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_REGISTER=5/300
RATE_LIMIT_REFRESH=30/60
RATE_LIMIT_PASSWORD_RESET_REQUEST=5/900
RATE_LIMIT_PASSWORD_RESET_SUBMIT=10/900
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_EXPIRE_MINUTES=60
STALE_ANALYSIS_MINUTES=10
REFRESH_SESSION_RETENTION_DAYS=30
RESET_TOKEN_RETENTION_DAYS=7
